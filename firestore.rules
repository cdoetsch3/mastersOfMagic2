rules_version = '2';

// Masters of Magic 2 — Firestore security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // The login content-version gate (lib/game/content_version.dart).
    // Public read on purpose: the client compares versions at boot, BEFORE
    // sign-in, and a guest on a stale build desyncs a duel exactly like an
    // account does. Nothing secret lives here — one integer.
    // Never client-writable: a client that could raise the number would gate
    // every other player out of the game.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Each user owns exactly their own account document, and everything
    // underneath it: the character list, and each character's per-town
    // storeroom and shop-stock documents (lib/game/profile_documents.dart).
    //
    // The recursive wildcard is deliberate. Every document below users/{uid}
    // is that user's own save by construction — the achievements progress/
    // subcollection is coming next — and a rule per level would be a rule to
    // forget to add. Ownership is decided once, at the top.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // characters/{cid}, and below it storerooms/{townId} and
      // shopStock/{townId}. A nested match does NOT inherit the parent's
      // allow, so this states the same owner check for the descendants.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ⚠️ The PRE-RESTRUCTURE profile document. Kept during the transition:
    // the client reads it once, on the first sign-in after the upgrade, to
    // convert it into users/{uid} — and it is never written again, so it
    // survives as a dead backup. Remove this block only once no build that
    // writes it can still sign in (see lib/game/content_version.dart).
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Matchmaking tickets: any signed-in player may read the queue and claim
    // a ticket; only the owner may create/delete their own ticket.
    match /matchmaking/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      // Claiming: another signed-in player may set claimedBy once.
      allow update: if request.auth != null
        && (request.auth.uid == uid
            || (resource.data.claimedBy == null
                && request.resource.data.claimedBy == request.auth.uid));
    }

    // The ladder bot pool (LADDER_DESIGN §4.1). A duel against a bot runs
    // entirely on the player's client against LocalAiDriver — nothing about
    // the match itself is stored — so the only shared write is the post-match
    // rating/record update, applied as an additive field-transform increment
    // (FirestoreRest.increment) so two simultaneous finishes against the same
    // bot both land instead of racing a read-modify-write.
    //
    // ⚠️ Firestore evaluates rules AFTER a fieldTransform is applied, against
    // the resulting document — so these per-field bounds apply to `increment`
    // writes exactly as they would to a plain `update`. There is no separate
    // "transform" rule to write.
    match /bots/{botId} {
      // ⭐ Every roster bot's two SEED ratings, mirrored from LadderRoster
      // (lib/game/ladder/ladder_bots.dart, LADDER_DESIGN §2's formulas).
      // ⚠️ Pinned by test/bot_seed_rules_test.dart, which parses this map
      // and fails the moment a bot is added, removed or re-seeded in code
      // without the same change here — and after such a change the rules
      // must be redeployed (`tool/deploy.sh --rules`), or every create for
      // the changed bot is refused.
      function seeds() {
        return {
          'wick': {'ratingGeared': 1107, 'ratingAcademy': 960},
          'pim': {'ratingGeared': 1161, 'ratingAcademy': 1080},
          'tansy': {'ratingGeared': 1200, 'ratingAcademy': 1080},
          'orrin': {'ratingGeared': 1239, 'ratingAcademy': 1140},
          'marlow': {'ratingGeared': 1263, 'ratingAcademy': 1140},
          'sable': {'ratingGeared': 1302, 'ratingAcademy': 1200},
          'dunstan': {'ratingGeared': 1311, 'ratingAcademy': 1080},
          'brightgale': {'ratingGeared': 1320, 'ratingAcademy': 1080},
          'quill': {'ratingGeared': 1374, 'ratingAcademy': 1200},
          'hesper': {'ratingGeared': 1413, 'ratingAcademy': 1200},
          'rook': {'ratingGeared': 1407, 'ratingAcademy': 1080},
          'isolde': {'ratingGeared': 1446, 'ratingAcademy': 1140},
          'garrick': {'ratingGeared': 1470, 'ratingAcademy': 1080},
          'thornwall': {'ratingGeared': 1521, 'ratingAcademy': 1200},
          'nettle': {'ratingGeared': 1545, 'ratingAcademy': 1200},
          'corvane': {'ratingGeared': 1569, 'ratingAcademy': 1140},
          'lisbet': {'ratingGeared': 1623, 'ratingAcademy': 1380},
          'ashbourne': {'ratingGeared': 1647, 'ratingAcademy': 1260},
          'vale': {'ratingGeared': 1671, 'ratingAcademy': 1320},
          'morwen': {'ratingGeared': 1710, 'ratingAcademy': 1320},
          'tarquin': {'ratingGeared': 1704, 'ratingAcademy': 1200},
          'seraphel': {'ratingGeared': 1758, 'ratingAcademy': 1320},
          'halvard': {'ratingGeared': 1782, 'ratingAcademy': 1260},
          'nyx': {'ratingGeared': 1836, 'ratingAcademy': 1380},
          'aldorian': {'ratingGeared': 1875, 'ratingAcademy': 1440},
          'ysolde': {'ratingGeared': 1860, 'ratingAcademy': 1380},
          'bramwell': {'ratingGeared': 1800, 'ratingAcademy': 1320}
        };
      }

      function isRosterBot() {
        return botId in seeds();
      }

      // Callers check isRosterBot() first — an unknown id has no seed.
      function seedOf(field) {
        return seeds()[botId][field];
      }

      // LADDER §2's anti-farm band: a bot's rating lives within ±300 of its
      // seed. The client clamps every write into it (Elo.clampToSeed), so a
      // stored value outside it — or no value at all — can only be a write
      // that went wrong. ⭐ Same test as BotRatings.isCorrupt on the client.
      function outOfBand(field) {
        return !(field in resource.data)
          || resource.data[field] < seedOf(field) - 300
          || resource.data[field] > seedOf(field) + 300;
      }

      // One rating field's update check. Untouched → fine. Otherwise EITHER
      // a normal result, |Δ| ≤ 40 (the most a single K-40 game can move a
      // rating, LADDER_DESIGN §2), OR the repair write below.
      //
      // ⭐ The repair (2026-09-25): a doc whose stored rating is outside the
      // band is corrupt by definition — Hesper and Rook were found at 8,
      // born of an increment that landed before any seed. From there the
      // |Δ| ≤ 40 bound refused every write that could fix them, and the
      // rating was stuck forever. So a write may set an out-of-band rating
      // to EXACTLY that bot's seed, in one step. 🚫 Not "any in-band value":
      // the seed is the only number a client can prove, and a healthy
      // in-band doc can never take this branch.
      function ratingOk(field) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
          || math.abs(request.resource.data[field]
              - resource.data.get(field, 0)) <= 40
          || (isRosterBot()
              && outOfBand(field)
              && request.resource.data[field] == seedOf(field));
      }

      // Any signed-in user may read the pool, anonymous guests included —
      // the Academy is the one mode a guest without an account can play.
      allow read: if request.auth != null;

      allow delete: if false;

      // ⭐ Every mutable field is spelled out — Firestore rules have no
      // loops — and a write may touch ONLY these six.
      //
      // ⭐ A bot is born at EXACTLY its seeds, both of them (2026-09-25).
      // This used to allow any rating in 0–3000, which let a field-transform
      // increment on a missing doc create it with `rating = delta` (a bot
      // born at 8). A create is now only ever BotRatings.record's seed
      // write; an increment that arrives first is refused, not banked.
      allow create: if request.auth != null
        && isRosterBot()
        && request.resource.data.keys().hasOnly([
          'ratingGeared', 'ratingAcademy',
          'winsGeared', 'lossesGeared',
          'winsAcademy', 'lossesAcademy',
          'updatedAt',
        ])
        && request.resource.data.get('ratingGeared', -1) == seedOf('ratingGeared')
        && request.resource.data.get('ratingAcademy', -1) == seedOf('ratingAcademy');

      // ⚠️ Each bound below is gated on the key actually CHANGING in this
      // write (affectedKeys), not on it merely existing in the post-write
      // document — after a transform the whole document is present, so an
      // Academy result landing on a bot that already has `winsGeared` would
      // otherwise be asked to bump winsGeared too, and be denied.
      //
      // ⚠️ Every existing-value read below goes through `.get(field, 0)`,
      // never bare `resource.data.field` — a bot document seeded with only
      // its ratings (the common case; wins/losses start absent and appear on
      // the first increment) would otherwise throw on an undefined key the
      // moment `winsGeared` first goes from absent to 1, turning a legitimate
      // first win into a denied write.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ratingGeared', 'ratingAcademy',
          'winsGeared', 'lossesGeared',
          'winsAcademy', 'lossesAcademy',
          'updatedAt',
        ])
        // |Δrating| ≤ 40, or the out-of-band repair — see ratingOk above.
        && ratingOk('ratingGeared')
        && ratingOk('ratingAcademy')
        // Win/loss counters only ever move by exactly +1 per match.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['winsGeared'])
            || request.resource.data.winsGeared
                == resource.data.get('winsGeared', 0) + 1)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lossesGeared'])
            || request.resource.data.lossesGeared
                == resource.data.get('lossesGeared', 0) + 1)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['winsAcademy'])
            || request.resource.data.winsAcademy
                == resource.data.get('winsAcademy', 0) + 1)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lossesAcademy'])
            || request.resource.data.lossesAcademy
                == resource.data.get('lossesAcademy', 0) + 1);
    }

    // Duel rooms + their turn documents. Room codes are unguessable secrets,
    // so signed-in access is the v1 trust model (commit-reveal handles move
    // secrecy; a server-authoritative layer can come later for ranked play).
    match /duels/{roomId} {
      allow read, create, update, delete: if request.auth != null;

      match /turns/{turnId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
