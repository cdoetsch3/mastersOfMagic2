# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Unanchored on purpose. Flutter's template ships `/build/`, which only matches
# the repo root — so `packages/mom_engine/build/` (created by `flutter test` in
# that package) was being tracked, including a 4MB .dill cache that churned on
# every test run. This form matches build/ at any depth.
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code session state and agent worktrees
.claude/

# Generator credentials. ⚠️ Read by tool/artgen.py when OPENAI_API_KEY is not
# already in the environment. A key must never reach a commit, a log line or an
# exception message — the tool is written so it cannot, and this is the other
# half of that promise.
.env

# Raw generated artwork. ⭐ art/state.json is committed and holds the prompt,
# its hash and the review history for every asset; the raws themselves cost
# cents to make again and are hundreds of megabytes to carry forever. What
# ships is the pixelated output under assets/, which IS committed.
# ⚠️ Whispering Woods' eleven creature sources predate artgen and are already
# tracked — git keeps tracking them, deliberately: nothing in the ledger can
# reproduce art that was made before the ledger existed.
art/source/
